# Native Next.js, authoritative realtime and durable worker. No runtime secrets in images.
ARG NODE_IMAGE
FROM ${NODE_IMAGE} AS build
WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates python3 python3-yaml sudo && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/realtime/package.json apps/realtime/package.json
COPY apps/worker/package.json apps/worker/package.json
RUN npm ci
COPY . .
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_TURNSTILE_SITE_KEY
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_REALTIME_URL
ARG GIT_SHA
ARG DEPLOY_ENV
ENV APP_ENV=$DEPLOY_ENV RELEASE_SHA=$GIT_SHA NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL \
    NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=$NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY \
    NEXT_PUBLIC_TURNSTILE_SITE_KEY=$NEXT_PUBLIC_TURNSTILE_SITE_KEY \
    NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL \
    NEXT_PUBLIC_REALTIME_URL=$NEXT_PUBLIC_REALTIME_URL \
    GIT_SHA=$GIT_SHA
# Source-bound omission for this explicitly authorized staging release only.
ARG SKIP_TESTS_ONCE_SHA
RUN if [ "$DEPLOY_ENV" = staging ] && [ -n "$SKIP_TESTS_ONCE_SHA" ] && [ "$SKIP_TESTS_ONCE_SHA" = "$GIT_SHA" ]; then \
      npm run typecheck && npm run build:deploy; \
    else npm run verify:ci && npm run build:deploy; fi

ARG NODE_IMAGE
FROM ${NODE_IMAGE} AS runtime
ARG SERVICE
ARG GIT_SHA
ARG DEPLOY_ENV
LABEL org.opencontainers.image.revision=$GIT_SHA nl.dartspoint.environment=$DEPLOY_ENV org.opencontainers.image.source=https://github.com/dartspoint/platform
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0
WORKDIR /app
COPY --from=build --chown=node:node /build/dist/deploy/${SERVICE}/ ./
COPY --chown=node:node ops/retained-log.mjs /app/retained-log.mjs
RUN mkdir -p /var/log/dartspoint && chown node:node /var/log/dartspoint && chmod 0700 /var/log/dartspoint
USER node
EXPOSE 3000
CMD ["node", "server.js"]
