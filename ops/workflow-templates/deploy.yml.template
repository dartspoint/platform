# Deployment runs only on protected environment branches and dedicated VPS runners.
name: Deploy DartsPoint
on:
  push:
    branches: [staging, production]
permissions:
  contents: read
concurrency:
  group: dartspoint-deploy-${{ github.ref_name }}
  cancel-in-progress: false
jobs:
  deploy:
    if: github.event_name == 'push' && (github.ref == 'refs/heads/staging' || github.ref == 'refs/heads/production')
    runs-on: [self-hosted, Linux, X64, "${{ github.ref_name == 'staging' && 'dartspoint-staging' || 'dartspoint-production' }}"]
    timeout-minutes: 90
    environment:
      name: ${{ github.ref_name }}
      url: ${{ vars.NEXT_PUBLIC_APP_URL }}
    steps:
      # Reviewed immutable checkout v4.2.2; refresh deliberately, never an unpinned branch.
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
          fetch-depth: 1
      - name: Prepare private configuration from GitHub Environment
        id: prepare
        env:
          DEPLOY_ENV: ${{ github.ref_name }}
          DATABASE_CA_CERT_BASE64: ${{ vars.DATABASE_CA_CERT_BASE64 }}
          NODE_IMAGE: ${{ vars.NODE_IMAGE }}
          REDIS_IMAGE: ${{ vars.REDIS_IMAGE }}
          NEXT_PUBLIC_APP_URL: ${{ vars.NEXT_PUBLIC_APP_URL }}
          NEXT_PUBLIC_REALTIME_URL: ${{ vars.NEXT_PUBLIC_REALTIME_URL }}
          NEXT_PUBLIC_SUPABASE_URL: ${{ vars.NEXT_PUBLIC_SUPABASE_URL }}
          NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: ${{ vars.NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY }}
          NEXT_PUBLIC_TURNSTILE_SITE_KEY: ${{ vars.NEXT_PUBLIC_TURNSTILE_SITE_KEY }}
          RESTIC_REPOSITORY: ${{ vars.RESTIC_REPOSITORY }}
          POSTGRES_IMAGE: ${{ vars.POSTGRES_IMAGE }}
          RESTIC_PASSWORD: ${{ secrets.RESTIC_PASSWORD }}
          AWS_ACCESS_KEY_ID: ${{ secrets.AWS_ACCESS_KEY_ID }}
          AWS_SECRET_ACCESS_KEY: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
          BACKUP_DATABASE_URL: ${{ secrets.BACKUP_DATABASE_URL }}
          MAIL_FROM: ${{ vars.MAIL_FROM }}
          MAIL_REPLY_TO: ${{ vars.MAIL_REPLY_TO }}
          SUPABASE_SECRET_KEY: ${{ secrets.SUPABASE_SECRET_KEY }}
          DATABASE_URL: ${{ secrets.DATABASE_URL }}
          MIGRATION_DATABASE_URL: ${{ secrets.MIGRATION_DATABASE_URL }}
          RESEND_API_KEY: ${{ secrets.RESEND_API_KEY }}
          INTERNAL_DEPLOY_TOKEN: ${{ secrets.INTERNAL_DEPLOY_TOKEN }}
        run: python3 ops/scripts/prepare-release.py
      - name: Verify and build exact SHA for this environment
        env:
          RELEASE_PATH: ${{ steps.prepare.outputs.release }}
        run: python3 ops/scripts/build-release.py "$RELEASE_PATH"
      - name: Backup gate, drain, migrate, activate and health check
        env:
          RELEASE_PATH: ${{ steps.prepare.outputs.release }}
        run: python3 ops/scripts/deploy.py "$RELEASE_PATH"
      - name: Final readiness
        run: python3 ops/scripts/health.py "$GITHUB_SHA"
# No pull_request/pull_request_target trigger on these privileged runners.
# No environment files, backups, logs or Docker inspection uploaded as artifacts.
# Workflow intentionally excludes BOOTSTRAP_OWNER_EMAIL: owner creation is one-off.
