# Hosted CI never receives staging or production credentials.
name: DartsPoint CI
on:
  push:
    branches: [main]
  pull_request:
    branches: [main, staging, production]
permissions:
  contents: read
concurrency:
  group: dartspoint-ci-${{ github.ref }}
  cancel-in-progress: true
jobs:
  verify:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with:
          persist-credentials: false
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
        with:
          node-version: 24.18.0
      - name: Verify in reviewed Node runtime without deployment credentials
        run: |
          NODE_IMAGE=$(python3 -c 'import json; print(json.load(open("ops/image-pins.json"))["NODE_IMAGE"])')
          docker run --rm --user "$(id -u):$(id -g)" --env NPM_CONFIG_CACHE=/tmp/npm-cache \
            --volume "$GITHUB_WORKSPACE:/workspace" --workdir /workspace "$NODE_IMAGE" \
            sh -c 'npm ci && npm run typecheck && npm test && node scripts/check-original-rules.mjs && npm run build:deploy'
          python3 ops/scripts/check-ops.py
          python3 scripts/check-source-parity.py
      - name: Start isolated infrastructure and run acceptance tests
        run: bash scripts/ci-integration.sh
