# Inventory only. For working local values use npm run local:setup.
APP_ENV=development
# Blog tokens are created by the owner in /beheer/blog and stored hashed in PostgreSQL.
# Optional stable site identity; credentials and receipts are also bound to APP_ENV.
# BLOG_SITE_ID=dartspoint
# Canonical origins default to the existing NL/EN domains for the environment.
# BLOG_CANONICAL_NL_ORIGIN=https://staging.dartspoint.nl
# BLOG_CANONICAL_EN_ORIGIN=https://staging.dartspoint.app
RELEASE_SHA=local-development
NEXT_PUBLIC_APP_URL=http://127.0.0.1:4300
NEXT_PUBLIC_REALTIME_URL=ws://127.0.0.1:42567
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:62421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_LOCAL_PUBLISHABLE_KEY
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
SUPABASE_SECRET_KEY=REPLACE_LOCAL_SERVER_KEY
DATABASE_URL=REPLACE_LIMITED_LOCAL_DATABASE_URL
MIGRATION_DATABASE_URL=REPLACE_LOCAL_MIGRATION_DATABASE_URL
REDIS_URL=redis://127.0.0.1:62479
INTERNAL_DEPLOY_TOKEN=REPLACE_RANDOM_BASE64URL_32_BYTES
REALTIME_HEALTH_URL=http://127.0.0.1:42567
WORKER_ID=dartspoint-development
MAIL_PROVIDER=local
LOCAL_MAILPIT_URL=http://127.0.0.1:62424
MAIL_FROM=DartsPoint <noreply@dartspoint.local>
MAIL_REPLY_TO=support@dartspoint.local

# Hosted staging/production settings are listed in ops/environment.example and
# docs/GITHUB-ENVIRONMENTS.md, separately from these local development values.
# Hetzner S3 backups use RESTIC_REPOSITORY, AWS_DEFAULT_REGION,
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY and self-chosen RESTIC_PASSWORD.
# Never put backup/migration secrets into permanent application containers.
